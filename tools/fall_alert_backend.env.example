# Backend auth token. Must match FALL_GATEWAY_AUTH_TOKEN in the WS63 firmware.
FALL_BACKEND_TOKEN=change-me-demo-token

# Duplicate alert suppression on the backend side.
FALL_RATE_LIMIT_SECONDS=60

# Start with dry-run. Set FALL_NOTIFY_DRY_RUN=0 after cloud templates pass.
FALL_NOTIFY_PROVIDER=dryrun
FALL_NOTIFY_DRY_RUN=1
FALL_NOTIFY_CHANNELS=sms,voice

# Use E.164 format for Tencent Cloud, for example +8613800138000.
FALL_CONTACTS=+8613800138000,+8613900139000

# PushPlus personal WeChat push. Required when:
# FALL_NOTIFY_PROVIDER=pushplus
# FALL_NOTIFY_DRY_RUN=0
PUSHPLUS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PUSHPLUS_CHANNEL=wechat
# Optional group topic token.
PUSHPLUS_TOPIC=

# Tencent Cloud SMS + voice. Required when:
# FALL_NOTIFY_PROVIDER=tencent
# FALL_NOTIFY_DRY_RUN=0
TENCENT_SECRET_ID=AKIDxxxxxxxxxxxxxxxx
TENCENT_SECRET_KEY=xxxxxxxxxxxxxxxx
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_SDK_APP_ID=1400000000
TENCENT_SMS_SIGN_NAME=你的短信签名
TENCENT_SMS_TEMPLATE_ID=1234567
TENCENT_VMS_REGION=ap-guangzhou
TENCENT_VMS_SDK_APP_ID=1400000000
TENCENT_VMS_TEMPLATE_ID=1234567
